# ── Touba Infos — variables d'environnement ────────────────────────────────
# Copier en .env.local (non versionné) et renseigner les valeurs.

# Espace rédaction /touba-infos/admin (mot de passe de connexion)
TI_ADMIN_PASSWORD=change-me

# Agent IA de veille — secret protégeant la route cron
#   GET /api/touba-infos/agent/veille?secret=XXXX
TI_AGENT_SECRET=change-me

# Rédaction IA de l'agent (facultatif mais recommandé en production).
# Sans clé, l'agent produit un brouillon "squelette" à compléter par la
# rédaction. Avec une clé, il rédige un article original complet.
# Fournisseurs essayés dans l'ordre : Anthropic, puis OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modèle à utiliser (défaut : claude-sonnet-5 pour Anthropic).
TI_AGENT_MODEL=

# Publication automatique par l'agent de veille — HÉRITÉ.
#   Aucune route du code actuel ne lit cette variable. Les intégrations
#   (AMY IA via /integrations/incoming, Claude via /mcp) créent TOUJOURS des
#   brouillons, quelle que soit sa valeur : la publication se fait
#   uniquement dans /admin. Laisser à « off ».
TI_AGENT_AUTOPUBLISH=off
# Nombre max d'articles rédigés/publiés par passage de veille (défaut 5).
TI_AGENT_MAX_PER_RUN=5

# ── Agence Touba Visuel (déjà utilisées par le site principal) ──────────────
# DATABASE_URL=postgresql://...
# ADMIN_SECRET=...

# PayDunya — ebooks Touba Infos (ne jamais préfixer par NEXT_PUBLIC_)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# sandbox ou live
PAYDUNYA_MODE=sandbox
# URL canonique publique, utilisée pour les retours et IPN
NEXT_PUBLIC_SITE_URL=https://toubainfos.com

# ── Intégration AMY IA (endpoint POST /api/touba-infos/integrations/incoming) ──
# Secret partagé, envoyé via Authorization: Bearer <secret>
TOUBA_INFOS_INTEGRATION_SECRET=

# ── Connecteur MCP Claude (endpoint POST /api/touba-infos/mcp) ──────────────
# Secret dédié (32 caractères minimum), distinct du secret AMY et du mot de
# passe admin. Envoyé par Claude via Authorization: Bearer <secret>.
# Sans valeur valide, le connecteur répond 503 (désactivé).
# Générer par exemple avec : openssl rand -hex 32
TOUBA_INFOS_MCP_SECRET=

# ── Images des intégrations ─────────────────────────────────────────────────
# Seules les images déjà stockées dans CE stockage Vercel Blob (dossier
# touba-infos/) sont utilisées automatiquement. Toute autre adresse est
# seulement conservée en suggestion pour la rédaction.
# Facultatif : déduit de BLOB_READ_WRITE_TOKEN si absent.
# Exemple : abcd1234efgh.public.blob.vercel-storage.com
TI_BLOB_PUBLIC_HOST=
