# ── Touba Infos — variables d'environnement ────────────────────────────────
# Copier en .env.local (non versionné) et renseigner les valeurs.

# Espace rédaction /touba-infos/admin (mot de passe de connexion)
TI_ADMIN_PASSWORD=change-me

# Agent IA de veille — secret protégeant la route cron
#   GET /api/touba-infos/agent/veille?secret=XXXX
TI_AGENT_SECRET=change-me

# Rédaction IA de l'agent (facultatif mais recommandé en production).
# Sans clé, l'agent produit un brouillon "squelette" à compléter par la
# rédaction. Avec une clé, il rédige un article original complet.
# Fournisseurs essayés dans l'ordre : Anthropic, puis OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modèle à utiliser (défaut : claude-sonnet-5 pour Anthropic).
TI_AGENT_MODEL=

# Publication automatique par l'agent (nécessite une clé IA ci-dessus) :
#   off       → l'agent crée des brouillons, publication manuelle (défaut, sûr)
#   assisted  → publie seul les sujets non sensibles, brouillon pour les sensibles
#   full      → publie automatiquement tout ce que l'IA rédige (aucune validation)
# Un article "squelette" (IA indisponible) n'est JAMAIS publié automatiquement.
TI_AGENT_AUTOPUBLISH=off
# Nombre max d'articles rédigés/publiés par passage de veille (défaut 5).
TI_AGENT_MAX_PER_RUN=5

# ── Agence Touba Visuel (déjà utilisées par le site principal) ──────────────
# DATABASE_URL=postgresql://...
# ADMIN_SECRET=...

# PayDunya — ebooks Touba Infos (ne jamais préfixer par NEXT_PUBLIC_)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# sandbox ou live
PAYDUNYA_MODE=sandbox
# URL canonique publique, utilisée pour les retours et IPN
NEXT_PUBLIC_SITE_URL=https://toubainfos.com
