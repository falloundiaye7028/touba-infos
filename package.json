{
  "name": "touba-infos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:baseline": "node scripts/prisma-baseline.mjs",
    "db:migrate:deploy": "npm run db:baseline && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "next": "^15.3.2",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.33.4",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8",
    "prisma": "^5.17.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
